// =====================================================================
//  OptSys - rack-and-pinion rail carriage for 2020 V-slot
//
//  Carriage that slides on a 2020 V-slot extrusion on six Ø4 PTFE tubes
//  (two on the top face, two on the sides, two in the V of the side
//  slots) and is driven by a pinion on a Ø4 / M4 shaft running in two
//  604ZZ bearings, meshing with a rack locked in the top slot.
//
//  Two mounts from one file:
//    top  - XY carriage: four M4 nuts under the top face (25 mm square)
//           to stack another stage or fix a part on it.
//    side - Z carriage: a tower with four counterbored M4 holes.
//  The pinion, knob and rack are generated by the same file, so the gear
//  mesh always matches the carriage.
//
//  Coordinates: rail (extrusion) axis = X, carriage centered on x = 0,
//  bottom face on z = 0 (print orientation), profile axis at y = 0,
//  z = skirt. The top face of the profile is at z = skirt + size / 2.
//
//  Shared code (gears, standards, hardware, ...) lives in ../../lib.
// =====================================================================

use <../../lib/optsys.scad>

/* [Output] */
// What to generate
part = "assembly"; // [assembly:Assembly (view), carriage:Carriage, pinion:Pinion, knob:Knob, rack:Rack]
// Ghost profile, tubes, bearings, shaft and knob in the assembly
show_hardware = true;

/* [Type] */
// top: XY carriage with M4 nuts under the top face (stackable). side: Z carriage with a tower and counterbored M4 holes
mount = "top"; // [top:Top mount (XY carriage), side:Side tower (Z carriage)]
// Extrusion standard
profile = "2020V"; // [2020V:2020 V-slot]

/* [Body] */
// Length along the rail
body_len = 40; // [20:0.5:200]
// Width across the rail
body_w = 40; // [30:0.5:120]
// Height of the top face (side mount: height of the base outside the tower)
body_h = 30; // [10:0.5:120]
// Distance from the bottom face up to the profile axis
skirt = 1.65; // [0:0.05:10]
edge_chamfer = 0.4; // [0:0.1:2]

/* [PTFE tubes] */
// Outer diameter of the PTFE tubes
tube_d = 4; // [2:0.05:8]
// Diametral clearance of the tube seats
seat_clearance = 0.1; // [-0.3:0.05:1]
// Top tubes: distance from the profile axis (they rest on the top face)
top_tube_y = 6.6; // [3:0.05:15]
// Top tubes: pushed into the top face (preload, negative = gap)
top_tube_preload = 0; // [-0.5:0.01:0.5]
// Side tubes: height above the profile axis (they rest on the side faces)
side_tube_z = 9.15; // [0:0.05:15]
// Side tubes: gap to the side face (negative = preload)
side_tube_gap = 0.05; // [-0.5:0.01:0.5]
// V tubes: height above the profile axis (they rest on the upper flank of the side slot V)
v_tube_z = 2.4; // [-5:0.05:8]
// V tubes: pushed into the V flank (preload, negative = gap)
v_tube_preload = 0; // [-0.5:0.01:0.5]

/* [Profile channel] */
// Gap between the channel walls and the profile sides
wall_gap = 1.16; // [0.2:0.01:3]
// Gap between the channel ceiling and the profile top
ceiling_gap = 1; // [0.2:0.01:3]
// How far the lower lips reach into the side slots (retention)
lip_depth = 2.66; // [0:0.01:4]
// Gap between the lip and the V flank
lip_clear = 1; // [0.2:0.05:3]
// Radius of the lead-in under the lip, around the V tube
lead_in_r = 4.03; // [2:0.01:8]

/* [Rack and pinion] */
gear_module = 0.8; // [0.4:0.05:2]
pinion_teeth = 16; // [8:1:60]
pressure_angle = 20; // [14.5:0.5:25]
pinion_w = 6; // [2:0.1:15]
// Tooth thickness removed at the pitch line (pinion and rack each; total play = sum)
pinion_backlash = 0.1; // [0:0.01:0.5]
rack_backlash = 0.1; // [0:0.01:0.5]
// Rack pitch line relative to the profile top face (+ = above)
pitch_line_offset = -0.05; // [-2:0.01:2]
// Pinion axis position along the rail, from the body center
pinion_x = 0; // [-100:0.5:100]
// Width of the slot the pinion turns in
pinion_slot_w = 6.3; // [2:0.05:16]
// Radial clearance around the pinion tips at the pocket sides
pocket_clear = 0.8; // [0.2:0.05:3]
// Clearance between the pinion tips and the 45 deg roof of the pocket (printed roofs sag)
roof_clear = 1.3; // [0.2:0.05:5]
// Clearance above the pinion tips (flat top of the pocket)
pocket_top_clear = 1.5; // [0.2:0.05:5]
// Optional slot for the rack teeth along the whole carriage (0 = none: the rack teeth pass under the channel ceiling)
rack_slot_h = 0; // [0:0.1:10]
rack_slot_w = 6.3; // [2:0.05:16]

/* [Shaft and bearings] */
bearing = "604ZZ"; // [MR84ZZ:MR84ZZ 4x8x3, 623ZZ:623ZZ 3x10x4, 604ZZ:604ZZ 4x12x4, 624ZZ:624ZZ 4x13x5, 605ZZ:605ZZ 5x14x5, 625ZZ:625ZZ 5x16x5]
// Diametral clearance of the bearing pockets (0 = press fit)
bearing_fit = 0; // [-0.2:0.05:0.5]
// Pocket depth beyond the bearing width
bearing_recess = 1; // [0:0.1:5]
// Shaft clearance hole between the bearings
shaft_hole_d = 5; // [2:0.1:10]

/* [Top mount (XY)] */
top_screw = "M4"; // [M3, M4, M5]
// Square hole pattern (center to center)
top_grid = 25; // [8:0.5:100]
top_hole_depth = 10; // [2:0.5:40]
// Depth of the nut center below the top face
top_nut_depth = 3.5; // [2:0.1:20]
// Added to the nut across-flats and thickness
top_nut_clear = 0; // [0:0.05:1]
// Blind holes for self-tapping M4 screws (tap drill) on the +Y half. Together with the nut holes on -Y they form
// the 25 x 18 pattern of the Z tower (tap_y = tower_grid_z - top_grid / 2), so a Z carriage bolts onto an XY one
tap_holes = true;
tap_d = 3.3; // [1.5:0.05:6]
// Y position of the tap holes (X = ± top_grid / 2)
tap_y = 5.5; // [0:0.1:50]

/* [Side tower (Z)] */
// Tower thickness along the rail, starting at the -X end
tower_t = 19; // [5:0.5:100]
// Total tower height
tower_h = 58; // [20:0.5:200]
tower_screw = "M4"; // [M3, M4, M5]
// Hole spacing across the rail
tower_grid_y = 25; // [8:0.5:100]
// Height of the first row of holes
tower_hole_z = 32.5; // [5:0.5:200]
// Spacing between rows
tower_grid_z = 18; // [5:0.5:100]
tower_rows = 2; // [1:1:6]
// Counterbore for the screw heads, from the -X face
tower_cbore_d = 7.5; // [4:0.1:15]
tower_cbore_depth = 13; // [0:0.5:100]

/* [Pinion] */
// solid: no bore. tap: tap drill to thread it onto an M4 rod. hex: M4 clearance + captive nut
pinion_bore = "tap"; // [solid:Solid, tap:Tap drill (thread onto M4 rod), hex:Clearance + captive M4 nut]
pinion_tap_d = 3.3; // [1:0.05:8]

/* [Knob] */
knob_d = 25; // [10:0.5:60]
knob_h = 10; // [4:0.5:30]
knob_lobes = 7; // [3:1:16]
// Scallops between lobes: radius and distance of their center from the axis
scallop_r = 6.5; // [1:0.1:20]
scallop_dist = 17.5; // [5:0.1:40]
knob_chamfer = 0.8; // [0:0.1:3]
// Captive nut on the bottom face
knob_nut = "M4"; // [M3, M4, M5, M6]
knob_nut_clear = 0.2; // [0:0.05:1]
knob_nut_depth = 3; // [1:0.1:10]
knob_bore_d = 5; // [2:0.1:12]
// Recess on the top face
knob_recess_d = 14.6; // [0:0.1:50]
knob_recess_h = 3; // [0:0.1:10]

/* [Rack] */
// Rack length (rounded to a whole number of teeth so racks can be butted end to end)
rack_len = 110; // [10:0.5:1000]
// Clearance between the rack base and the slot cavity walls
rack_side_clear = 0.25; // [0:0.05:1]
// Clearance to the cavity floor
rack_floor_clear = 0.14; // [0:0.01:1]
// 45 deg chamfer of the rack base bottom edges
rack_chamfer = 2.45; // [0:0.05:5]
// Clearance between the tooth bar and the slot opening (total)
rack_bar_clear = 0.2; // [0:0.05:1]
// Set screws pushing the rack up against the slot lips
setscrews = "thread"; // [thread:Modeled M3 thread, tap:Tap drill, none:None]
setscrew_n = 3; // [0:1:50]
setscrew_pitch = 37.5; // [5:0.5:500]
// Diametral clearance of the modeled thread (negative = tighter)
setscrew_clearance = -0.08; // [-0.3:0.01:0.5]

/* [Quality] */
$fn = 64;
chamfer_steps = 5;

/* [Hidden] */
eps = 0.01;

// ---------------------------------------------------------------------
// Derived values
// ---------------------------------------------------------------------
is_side = str(mount) == "side";
H   = body_h;
L   = body_len;
W   = body_w;
ps  = extrusion_size(profile);
h   = ps / 2;
v_a = extrusion_v_w(profile) / 2;     // V flank line: z + d = v_a (d = depth into the profile)
pz  = skirt;                          // profile axis height
seat_r = (tube_d + seat_clearance) / 2;
tr  = tube_d / 2;

// tube centers (profile coordinates, left side; mirrored to the right)
top_tube  = [-top_tube_y, h + tr - top_tube_preload];
side_tube = [-(h + tr + side_tube_gap), side_tube_z];
v_tube    = [-h + (v_a - (tr - v_tube_preload) * sqrt(2) - v_tube_z), v_tube_z];
lip_a     = v_a - lip_clear * sqrt(2);   // lip flank line: z + d = lip_a

// gears
rp      = gear_pitch_r(gear_module, pinion_teeth);
ra      = gear_tip_r(gear_module, pinion_teeth);
pitch_z = pz + h + pitch_line_offset;     // rack pitch line (absolute)
gz      = pitch_z + rp;                   // pinion axis height
travel  = PI * gear_module * pinion_teeth;

// shaft and bearings
b_od    = bearing_od(bearing);
b_w     = bearing_w(bearing);
b_id    = bearing_id(bearing);
b_in    = W / 2 - (b_w + bearing_recess);   // inner face of the bearing pockets (|y|)

// pinion pocket
pk_r    = ra + pocket_clear;
pk_top  = gz + ra + pocket_top_clear;
ceil_z  = pz + h + ceiling_gap;
pk_k    = (ra + roof_clear) * sqrt(2);  // 45 deg roof tangent to the roof clearance circle
pk_z45  = gz + pk_k - pk_r;             // the roof starts here, at x = ±pk_r

// height of the solid at the pinion
top_z   = is_side ? tower_h : H;

// top mount
tm_pos  = [for (sx = [-1, 1], sy = [-1, 1]) [sx * top_grid / 2, sy * top_grid / 2]];
tm_af   = nut_af(top_screw) + top_nut_clear;
tm_t    = nut_t(top_screw) + top_nut_clear;
tm_ac   = nut_ac(tm_af);
tm_hole = clearance_d(top_screw);

// side tower
tw_x0   = -L / 2;
tw_x1   = -L / 2 + tower_t;
tw_hole = clearance_d(tower_screw);

// rack
rk_p    = rack_pitch(gear_module);
rk_n    = max(1, round(rack_len / rk_p));
rk_L    = rk_n * rk_p;
rk_zb   = extrusion_slot_depth(profile) - rack_floor_clear;   // local z of the profile face
rk_top  = extrusion_cavity_w(profile) / 2 - rack_side_clear;   // half width of the base
rk_bot  = rk_top - rack_chamfer;
rk_base_top = rk_zb - extrusion_lip_t(profile);
rk_zp   = rk_zb + pitch_line_offset;                            // local z of the pitch line
rk_bar  = extrusion_slot_w(profile) - rack_bar_clear;
rk_screws = setscrew_n < 1 ? [] : [for (i = [0:setscrew_n - 1])
    let(x = rk_L / 2 + (i - (setscrew_n - 1) / 2) * setscrew_pitch) round(x / rk_p) * rk_p];
assert(len(rk_screws) == 0 || (rk_screws[0] >= 2 && rk_screws[len(rk_screws) - 1] <= rk_L - 2),
       "The rack set screws do not fit: reduce setscrew_n or setscrew_pitch, or make the rack longer");

// ---------------------------------------------------------------------
// Summary and checks
// ---------------------------------------------------------------------
echo(str("Rail carriage ", profile, ", ", is_side ? "side tower (Z)" : "top mount (XY)", ": body ", L, " x ", W, " x ", top_z,
         " mm. Pinion m", gear_module, " z", pinion_teeth, " (pitch Ø", 2 * rp, ", tip Ø", 2 * ra, "), ",
         travel, " mm per knob turn. Bearings 2 x ", bearing, ". Rack: ", rk_n, " teeth = ", rk_L, " mm"));
echo(str("Tubes Ø", tube_d, ": top at y=±", -top_tube[0], ", side at y=±", -side_tube[0], " z=", side_tube[1],
         ", V at y=±", -v_tube[0], " z=", v_tube[1], " (profile coordinates). Tube length = ", L, " mm (",
         is_side ? "base" : "body", ")"));
if (!is_side) echo(str("Top mount: 4 x ", top_screw, " nuts on a ", top_grid, " mm square, ", top_hole_depth, " mm deep holes",
                       tap_holes ? str(". Tap holes at y=", tap_y, ": with the -Y nuts they make a ", top_grid, " x ", tap_y + top_grid / 2, " mm pattern for the Z tower") : ""));
else echo(str("Side tower: ", 2 * tower_rows, " x ", tower_screw, " counterbored holes, ", tower_grid_y, " x ", tower_grid_z,
              " mm grid. Screw length = ", tower_t - tower_cbore_depth, " mm + the part you fix"));

assert(gz - b_od / 2 - bearing_fit / 2 >= ceil_z - 0.5 || b_in > -side_tube[0] + seat_r + 0.6,
       "The bearing pockets cut into the side tube seats: increase body_w or use a smaller bearing");
assert(rack_slot_h > 0 || pitch_line_offset + gear_module + 0.15 <= ceiling_gap,
       "The rack teeth touch the channel ceiling: increase ceiling_gap or enable rack_slot_h");
assert(b_in > rack_slot_w / 2 + 1 && b_in > pinion_slot_w / 2 + 1, "No wall left between the bearing pockets and the pinion slot: increase body_w");
assert(gz + b_od / 2 + 1 <= top_z, str("The bearing pocket breaks through the top: increase body_h (min ", gz + b_od / 2 + 1, ")"));
assert(pk_top + 1 <= top_z, str("The pinion pocket breaks through the top: increase body_h (min ", pk_top + 1, ")"));
assert(pk_z45 < pk_top - 0.5 && pk_z45 > gz, "Pinion pocket roof: increase pocket_top_clear or reduce roof_clear (or raise pocket_clear)");
assert(shaft_hole_d > b_id, "shaft_hole_d must be larger than the bearing bore");
assert(rk_bot > 0, "rack_chamfer is larger than the rack base half width");
assert(!is_side || (pinion_x - pk_r >= tw_x0 + 0.8 && pinion_x + pk_r <= tw_x1 - 0.8) || gz + pk_r < H,
       "The pinion pocket comes out of the tower: move pinion_x or increase tower_t");
assert(abs(pinion_x) + pk_r <= L / 2 + 1, "The pinion is outside the body: check pinion_x");
assert(is_side || top_grid / 2 - tm_hole / 2 - (pk_r) >= 1 || H - top_hole_depth > pk_top,
       "The top holes reach the pinion pocket: increase top_grid or reduce top_hole_depth");
assert(is_side || H - top_nut_depth - tm_ac / 2 > gz + b_od / 2 + 0.6 || top_grid / 2 - tm_af / 2 > b_od / 2 + 0.6,
       "The top nuts touch the bearing pockets: increase body_h or top_nut_depth");
assert(is_side || top_nut_depth - tm_t / 2 >= 1, "Less than 1 mm of plastic above the top nuts: increase top_nut_depth");
assert(is_side || !tap_holes || ((top_grid / 2 - tap_d / 2 >= pk_r + 0.8 || tap_y - tap_d / 2 >= pinion_slot_w / 2 + 0.8 ||
       H - top_hole_depth >= pk_top + 0.8) && top_grid / 2 - tap_y > (tm_hole + tap_d) / 2 + 0.8),
       "The tap holes collide with the pinion pocket or the top holes: adjust tap_y");
assert(!is_side || tower_hole_z - tower_cbore_d / 2 >= pk_top + 1, "The tower holes cut into the pinion pocket: raise tower_hole_z");
assert(!is_side || tower_hole_z + (tower_rows - 1) * tower_grid_z + tower_cbore_d / 2 + 1 <= tower_h, "The tower holes do not fit: increase tower_h");
assert(!is_side || tower_cbore_depth < tower_t - 2, "The counterbore goes through the tower: reduce tower_cbore_depth");
assert(-v_tube[0] + seat_r < W / 2 - 1.5 && -side_tube[0] + seat_r < W / 2 - 1.5, "Side walls thinner than 1.5 mm: increase body_w");

// ---------------------------------------------------------------------
// Profile channel (YZ outline, profile coordinates)
// ---------------------------------------------------------------------
module lip_left2d() {
    // material under the V tube: lead-in arc, flank parallel to the V, tip in the slot
    intersection() {
        translate(v_tube) circle(lead_in_r, $fn = 96);
        polygon([[-60, lip_a - h + 60], [60, lip_a - h - 60], [60, -100], [-60, -100]]);   // z + d <= lip_a
        translate([-100, -100]) square([100 - h + lip_depth, 200]);                          // d <= lip_depth
    }
    translate([-100, -100]) square([100 + v_tube[0], 100 + v_tube[1]]);
}

module seats2d() {
    for (m = [0, 1]) mirror([m, 0]) for (c = [top_tube, side_tube, v_tube]) translate(c) circle(seat_r, $fn = 48);
}

module channel2d() {
    union() {
        difference() {
            translate([-(h + wall_gap), -pz - 1]) square([2 * (h + wall_gap), pz + 1 + h + ceiling_gap]);
            for (m = [0, 1]) mirror([m, 0]) lip_left2d();
        }
        if (rack_slot_h > 0) translate([-rack_slot_w / 2, 0]) square([rack_slot_w, h + rack_slot_h]);
        seats2d();
    }
}

// ---------------------------------------------------------------------
// Carriage
// ---------------------------------------------------------------------
module body() {
    chamfered_box([-L / 2, -W / 2, 0], [L / 2, W / 2, H], edge_chamfer);
    if (is_side) chamfered_box([tw_x0, -W / 2, 0], [tw_x1, W / 2, tower_h], edge_chamfer);
}

// Pinion pocket (XZ outline): straight sides down to the channel, 45 deg roof, flat top
module pinion_pocket2d() {
    z45 = pk_z45;
    half_top = max(0.5, pk_k - (pk_top - gz));
    translate([pinion_x, 0]) polygon([
        [-pk_r, ceil_z - eps], [pk_r, ceil_z - eps], [pk_r, z45],
        [half_top, pk_top], [-half_top, pk_top], [-pk_r, z45]]);
}

module top_mount_cuts() {
    for (p = tm_pos) {
        translate([p[0], p[1], H - top_hole_depth]) cylinder(d = tm_hole, h = top_hole_depth + 1);
        // nut slot, open on the nearest Y face
        sy = sign(p[1]);
        y_in = abs(p[1]) - tm_ac / 2 - 0.05;
        translate([p[0] - tm_af / 2, sy > 0 ? y_in : -W / 2 - 1, H - top_nut_depth - tm_t / 2])
            cube([tm_af, W / 2 + 1 - y_in, tm_t]);
    }
    if (tap_holes) for (sx = [-1, 1])
        translate([sx * top_grid / 2, tap_y, H - top_hole_depth]) cylinder(d = tap_d, h = top_hole_depth + 1, $fn = 32);
}

module tower_cuts() {
    for (r = [0:tower_rows - 1], sy = [-1, 1]) translate([0, sy * tower_grid_y / 2, tower_hole_z + r * tower_grid_z]) {
        translate([tw_x0 - 1, 0, 0]) rotate([0, 90, 0]) cylinder(d = tw_hole, h = tower_t + 2);
        if (tower_cbore_depth > 0) translate([tw_x0 - 1, 0, 0]) rotate([0, 90, 0]) cylinder(d = tower_cbore_d, h = tower_cbore_depth + 1);
    }
}

module carriage() {
    difference() {
        body();
        // profile channel, tube seats and rack slot (through)
        translate([0, 0, pz]) yz_extrude(-L / 2 - 1, L / 2 + 1) channel2d();
        // pinion pocket
        xz_extrude(pinion_slot_w) pinion_pocket2d();
        // shaft and bearings
        translate([pinion_x, 0, gz]) rotate([90, 0, 0]) {
            cylinder(d = shaft_hole_d, h = W + 2, center = true);
            for (s = [-1, 1]) translate([0, 0, s > 0 ? b_in : -W / 2 - 1]) cylinder(d = b_od + bearing_fit, h = W / 2 + 1 - b_in, $fn = 96);
        }
        if (is_side) tower_cuts(); else top_mount_cuts();
    }
}

// ---------------------------------------------------------------------
// Pinion, knob, rack
// ---------------------------------------------------------------------
module pinion() {
    difference() {
        linear_extrude(pinion_w) spur_gear2d(gear_module, pinion_teeth, pressure_angle, pinion_backlash);
        if (pinion_bore == "tap") {
            translate([0, 0, -1]) cylinder(d = pinion_tap_d, h = pinion_w + 2, $fn = 32);
            for (z = [0, pinion_w]) translate([0, 0, z]) mirror([0, 0, z > 0 ? 1 : 0])
                translate([0, 0, -eps]) cylinder(d1 = pinion_tap_d + 0.8, d2 = pinion_tap_d, h = 0.4 + eps, $fn = 32);
        }
        if (pinion_bore == "hex") {
            translate([0, 0, -1]) cylinder(d = clearance_d("M4"), h = pinion_w + 2, $fn = 32);
            translate([0, 0, pinion_w - nut_t("M4") - 0.2]) cylinder(d = nut_ac(nut_af("M4") + 0.15), h = pinion_w, $fn = 6);
        }
    }
}

module knob2d() {
    difference() {
        circle(d = knob_d, $fn = 128);
        for (i = [0:knob_lobes - 1]) rotate(360 * i / knob_lobes + 180 / knob_lobes) translate([scallop_dist, 0]) circle(scallop_r, $fn = 96);
    }
}

module knob() {
    k_ac = nut_ac(nut_af(knob_nut) + knob_nut_clear);
    difference() {
        chamfered_extrude(knob_h, knob_chamfer, chamfer_steps) knob2d();
        translate([0, 0, -1]) cylinder(d = k_ac, h = knob_nut_depth + 1, $fn = 6);
        translate([0, 0, -eps]) cylinder(d1 = k_ac + 0.8, d2 = k_ac, h = 0.4, $fn = 6);
        translate([0, 0, -1]) cylinder(d = knob_bore_d, h = knob_h + 2, $fn = 32);
        if (knob_recess_d > 0 && knob_recess_h > 0) {
            translate([0, 0, knob_h - knob_recess_h]) cylinder(d = knob_recess_d, h = knob_recess_h + 1);
            translate([0, 0, knob_h - 0.3]) cylinder(d1 = knob_recess_d, d2 = knob_recess_d + 0.6 + 2 * eps, h = 0.3 + eps);
        }
    }
}

// Rack in its print orientation: base on z = 0, teeth up, from x = 0 to rk_L.
// The profile face is at z = rk_zb.
module rack() {
    difference() {
        union() {
            yz_extrude(0, rk_L) polygon([[-rk_bot, 0], [rk_bot, 0], [rk_top, rack_chamfer], [rk_top, rk_base_top],
                                        [-rk_top, rk_base_top], [-rk_top, rack_chamfer]]);
            translate([0, 0, rk_zp]) xz_extrude(rk_bar)
                rack2d(gear_module, rk_n, pressure_angle, rack_backlash, rk_zp - rk_base_top + 0.5);
        }
        if (setscrews != "none") for (x = rk_screws) translate([x, 0, -1]) {
            if (setscrews == "thread") internal_thread_cutter(3, 0.5, rk_zp + gear_module + 2, setscrew_clearance, 48, 8);
            else cylinder(d = 2.5, h = rk_zp + gear_module + 2, $fn = 24);
        }
    }
}

// ---------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------
if (part == "carriage") carriage();
else if (part == "pinion") pinion();
else if (part == "knob") knob();
else if (part == "rack") rack();
else {
    color("DimGray") carriage();
    // pinion with a tooth pointing down into a rack gap
    color("Goldenrod") translate([pinion_x, pinion_w / 2, gz]) rotate([90, 0, 0])
        translate([0, 0, 0]) rotate(-90) pinion();
    // rack: a gap centered under the pinion
    gap_i = round(rk_n / 2);
    color("Goldenrod") translate([pinion_x - gap_i * rk_p, 0, pz + h - rk_zb]) rack();
    if (show_hardware) {
        %translate([0, 0, pz]) yz_extrude(-rk_L / 2 - 10, rk_L / 2 + 10) vslot_profile2d(profile);
        // PTFE tubes
        %translate([0, 0, pz]) yz_extrude(-L / 2, L / 2)
            for (m = [0, 1]) mirror([m, 0]) for (c = [top_tube, side_tube, v_tube]) translate(c) circle(d = tube_d, $fn = 24);
        // shaft, bearings and knob
        translate([pinion_x, 0, gz]) rotate([-90, 0, 0]) {
            %translate([0, 0, -W / 2 - 3]) cylinder(d = b_id, h = W + 3 + knob_h + 6, $fn = 24);
            for (s = [-1, 1]) %translate([0, 0, s > 0 ? b_in : -b_in - b_w]) difference() {
                cylinder(d = b_od, h = b_w); translate([0, 0, -1]) cylinder(d = b_id, h = b_w + 2, $fn = 24);
            }
            color("DimGray") translate([0, 0, W / 2 + 1 + knob_h]) mirror([0, 0, 1]) knob();
        }
    }
}
