{
    // Ctrl+Shift+B runs the default task: tools/check.sh.
    // On Windows it runs in Git Bash (installed with Git for Windows).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "OptSys: check all parts",
            "type": "shell",
            "command": "tools/check.sh",
            "windows": {
                "options": {
                    "shell": {
                        "executable": "C:\\Program Files\\Git\\bin\\bash.exe",
                        "args": ["-c"]
                    }
                }
            },
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always", "clear": true },
            "problemMatcher": []
        }
    ]
}
